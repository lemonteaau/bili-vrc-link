{
  "name": "bili-vrc-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "右键将 Bilibili 视频解析为 VRChat 播放器链接",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
