{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "mkdir -p public && echo User-agent: \\* > public/robots.txt",
  "outputDirectory": "public",
  "regions": ["hkg1"],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/api" }]
}
