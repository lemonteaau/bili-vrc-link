{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "mkdir -p public && echo User-agent: \\* > public/robots.txt",
  "outputDirectory": "public",
  "regions": ["hkg1"],
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "ignoreCommand": "if git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- api lib vercel.json .vercelignore; then exit 0; else exit 1; fi",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/api" }]
}
